# 本文件是配置说明模板，可以提交；复制后的 .env 被 Git 忽略。
# 当前教学脚本读取进程环境变量，不会自动加载 .env。
# 设置方法见 docs/integrations.md 和阶段 08 的 integrations/README.md。
# 所有默认离线示例都不需要填写这些配置。

# 阶段 08 / 56：支持 Chat Completions 的模型接口。
# 填写供应商最终 HTTPS 地址，例如 https://api.openai.com/v1。
# BASE_URL 不包含 /chat/completions；空值需在真实调用前填写。
MODEL_BASE_URL=
# 使用自己的密钥；不要把真实值写回本模板。
MODEL_API_KEY=
# 填写该账号支持的模型 ID，不预设某个模型。
MODEL_NAME=

# 阶段 49：本地教学 HTTP 服务，DATA_DIR 需要先创建且可写。
HOST=127.0.0.1
PORT=8080
DATA_DIR=artifacts/service-data

# 阶段 40：本地 Spring Boot 教学服务使用的演示令牌。
# 仅用于本地课程，不作为生产认证方案。
TICKET_SERVICE_TOKEN=local-teaching-token

# 阶段 55：可选图像与语音接入，按该阶段说明填写。
# Ollama 中已经安装、支持图像输入的模型名称。
OLLAMA_VISION_MODEL=
# 本地 faster-whisper 模型目录路径。
WHISPER_MODEL_DIR=
